# ============================================================
# Copy to .env and fill in real values. Never commit real keys.
# ============================================================

# --- Backend -------------------------------------------------
# Comma-separated API key pool (at least 2). Key ids are key_1, key_2, ... in this order.
# Example with Gemini keys from two Google AI Studio projects:
#   LLM_API_KEYS=AIzaSy...-first-key,AIzaSy...-second-key
LLM_API_KEYS=your-first-api-key,your-second-api-key

# LiteLLM model name (provider prefix required), e.g.:
#   gemini/gemini-3.5-flash-lite | openai/gpt-4o-mini | anthropic/claude-3-5-haiku-latest
#   groq/llama-3.3-70b-versatile | openrouter/openai/gpt-4o-mini
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Optional custom base URL for OpenAI-compatible endpoints (leave empty otherwise)
LLM_API_BASE=

# Per-attempt timeout in seconds
LLM_TIMEOUT_SECONDS=60

# SQLite location. In Docker this MUST be under the mounted /data volume.
DATABASE_URL=sqlite:////data/app.db

# CORS origins allowed to call the backend (comma-separated).
# For production add your deployed frontend URL:
#   ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Failover test hook (required true on the deployed backend for grading)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM built-in response cache (in-memory)
CACHE_ENABLED=true
# Cache TTL seconds; 0 = keep for the lifetime of the process
CACHE_TTL_SECONDS=0

# How long a key is benched after a real 429/quota/5xx failure (seconds)
KEY_COOLDOWN_SECONDS=30

# Default persona when the client sends no system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant. Answer clearly and accurately.

# --- Frontend (build-time) -----------------------------------
# Base URL of the deployed backend, baked into the static bundle.
# Local Docker default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
